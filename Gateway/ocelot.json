{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/products",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamScheme": "http",
      "DownstreamPathTemplate": "/api/products",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5001 } ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/gateway/products/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamScheme": "http",
      "DownstreamPathTemplate": "/api/products/{id}",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5001 } ],
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/gateway/products",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamScheme": "http",
      "DownstreamPathTemplate": "/api/products",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5001 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "GatewayKey" ] },
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/gateway/products/{id}",
      "UpstreamHttpMethod": [ "PUT", "DELETE" ],
      "DownstreamScheme": "http",
      "DownstreamPathTemplate": "/api/products/{id}",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5001 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "GatewayKey" ] },
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/gateway/orders",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamScheme": "http",
      "DownstreamPathTemplate": "/api/orders",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5002 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "GatewayKey" ] },
      "Priority": 10
    },
    {
      "UpstreamPathTemplate": "/gateway/auth/login",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamScheme": "http",
      "DownstreamPathTemplate": "/api/auth/login",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5003 } ],
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "ClientIdHeader": "ClientId",
        "Period": "10s",
        "PeriodTimespan": 10,
        "Limit": 5
      },
      "Priority": 10
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}
